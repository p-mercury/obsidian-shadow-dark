{
	"name": "obsidian-shadow-dark",
	"version": "1.0.0",
	"description": "Shadowdark plugin for obsidian",
	"keywords": [],
	"license": "Apache-2.0",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"prettier": {
		"plugins": [
			"prettier-plugin-packagejson",
			"prettier-plugin-svelte"
		],
		"useTabs": true,
		"overrides": [
			{
				"files": "*.svelte",
				"options": {
					"parser": "svelte"
				}
			}
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.4.0",
		"esbuild": "0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.11.0",
		"jiti": "^2.7.0",
		"obsidian": "latest",
		"prettier": "^3.9.6",
		"prettier-plugin-packagejson": "^3.0.2",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
